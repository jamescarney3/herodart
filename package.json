{
  "name": "herodart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "tsc -b --noEmit && vite build --watch",
    "compile:watch": "tsc -b --noEmit --watch",
    "lint": "pnpm run lint:app && pnpm run lint:styles",
    "lint:app": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:app:fix": "prettier . --write && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:styles": "stylelint **/*.{css,scss}",
    "lint:styles:fix": "stylelint --fix **/*.{css,scss}",
    "preview": "vite preview",
    "test": "vitest",
    "test:nyan": "vitest --reporter=vitest-nyancat-reporter",
    "test:verbose": "vitest --reporter=verbose",
    "test:ci": "vitest run --coverage --coverage.reporter=json-summary --watch=false",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "sass": "^1.92.1",
    "sass-tailwind-functions": "^2.0.0",
    "sinon": "^20.0.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.12.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^5.4.20",
    "vite-plugin-babel": "^1.3.2",
    "vitest": "^2.1.9",
    "vitest-nyancat-reporter": "^1.0.0"
  }
}
